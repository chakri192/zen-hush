{
  "manifest_version": 3,
  "name": "Zen Hush",
  "version": "0.2.0",
  "description": "Scheduled Do Not Disturb and per-site muting for the web Notification API. Companion to the Zen Hush toast mod.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-hush@chakri192.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage", "activeTab"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Zen Hush",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
